# =============================================================================
# Sutura -- Azure production .env TEMPLATE
#
# This is the SHAPE of the file that deploy.sh renders to /opt/sutura/.env on
# the VM by reading each value from Azure Key Vault. Do NOT commit real secrets.
# For a manual/first deploy you can copy this to .env and fill it in by hand.
#
# Generate every secret with:  openssl rand -hex 32
# =============================================================================

# --- Deployment / registry (set by IaC + CI, not secrets) --------------------
# ACR login server, e.g. suturaacr.azurecr.io
ACR_LOGIN_SERVER=
# Image tag to run (git SHA or release tag). CI updates this per deploy.
IMAGE_TAG=latest

# --- Public hostnames + TLS --------------------------------------------------
# Both must have DNS records pointing at the VM public IP.
APP_DOMAIN=app.example.com        # dashboard
API_DOMAIN=api.example.com        # backend (browser-reachable origin)
ACME_EMAIL=ops@example.com        # Let's Encrypt account / expiry notices

# --- Required secrets (no insecure defaults allowed in production) ------------
JWT_SECRET=
INTEGRATION_ENCRYPTION_KEY=
POSTGRES_PASSWORD=
REDIS_PASSWORD=

# --- Anthropic (global fallback; per-org keys preferred) ---------------------
ANTHROPIC_API_KEY=

# --- Vector DB (Pinecone) + embeddings (Voyage) ------------------------------
PINECONE_API_KEY=
PINECONE_ENVIRONMENT=
VOYAGE_API_KEY=

# --- GitHub App --------------------------------------------------------------
GITHUB_APP_ID=
# PEM with literal \n escapes on a single line.
GITHUB_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
GITHUB_APP_SLUG=

# --- Scanner integrations (webhooks at https://${API_DOMAIN}/webhooks/...) ----
AIKIDO_WEBHOOK_SECRET=
SNYK_API_TOKEN=
SNYK_WEBHOOK_SECRET=

# --- Scanner sync (outbound poll; use when inbound webhooks aren't reachable) -
SCANNER_SYNC_ENABLED=false
SCANNER_SYNC_INTERVAL_MS=900000

# --- Email / SMTP (dashboard: password-reset & invite links) -----------------
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Sutura <noreply@example.com>

# --- Bootstrap initial owner (dashboard) -------------------------------------
BOOTSTRAP_OWNER_EMAIL=
BOOTSTRAP_OWNER_PASSWORD=

# --- Optional sandbox tuning (defaults applied in compose if unset) ----------
# SUTURA_INSTALL_TIMEOUT_MS=600000
# SUTURA_TEST_TIMEOUT_MS=420000
# SUTURA_GRADER_TIMEOUT_MS=900000
# SANDBOX_HOME_TMPFS_MB=4096
# SUTURA_SANDBOX_MEMORY_BYTES=6442450944
# SANDBOX_CACHE_TTL_DAYS=14

# --- Optional feature flags ('1' to disable) ---------------------------------
# SUTURA_VALIDATED_FIX_DISABLED=
# SUTURA_VERIFY_DISABLED=
# SUTURA_PREWARM_DISABLED=
