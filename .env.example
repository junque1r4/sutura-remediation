# =============================================================================
# Sutura environment example
# Copy to .env and fill in real values. NEVER commit a real .env.
# Placeholders below are NOT valid secrets - replace every "replace-me-*" entry.
# =============================================================================

# --- Required secrets (no insecure defaults allowed) ---
# Generate each with: openssl rand -hex 32
JWT_SECRET=replace-me-generate-with-openssl-rand-hex-32
# Postgres + Redis passwords used by docker-compose. Cold start fails loudly if
# either is unset. Generate with: openssl rand -hex 32
# NOTE: postgres only applies POSTGRES_PASSWORD at initdb (first boot, empty
# volume). Changing it after the postgres-data volume exists yields a 28P01
# password-auth failure at runtime. See README "Rotating the database password"
# before changing this on an existing volume.
POSTGRES_PASSWORD=replace-me-generate-with-openssl-rand-hex-32
REDIS_PASSWORD=replace-me-generate-with-openssl-rand-hex-32

# --- Database ---
# Use the same value as POSTGRES_PASSWORD in the password segment below.
DATABASE_URL=postgres://sutura:replace-me-postgres-password@localhost:5432/sutura

# --- Anthropic ---
ANTHROPIC_API_KEY=

# --- Vector DB (Pinecone) ---
PINECONE_API_KEY=
PINECONE_ENVIRONMENT=

# --- Embeddings (Voyage AI) ---
VOYAGE_API_KEY=

# --- GitHub ---
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
GITHUB_APP_SLUG=              # GitHub App URL slug (e.g. "sutura-dev")

# --- Redis (BullMQ) ---
# Use the same value as REDIS_PASSWORD in the password segment below.
REDIS_URL=redis://default:replace-me-redis-password@localhost:6379

# --- Dashboard ---
# Must be the browser-reachable backend origin (the URL a user's browser hits),
# not an internal Docker service name. Example for local dev: http://localhost:3001
NEXT_PUBLIC_BACKEND_URL=http://localhost:3001

# --- Sandbox Runtime (validated-fix worker) ---
# Controls how the worker spawns sibling sandbox containers. All defaults are
# safe for local dev/CI without gVisor, a socket proxy, or any extra setup.
#
# OCI runtime: 'runc' (default in dev) or 'runsc' (gVisor; required in
# production). In production the backend refuses to boot on runc.
SANDBOX_RUNTIME=runc
# When false (default) sandbox containers run on an internal no-egress network;
# only the install step opts into egress. Set true to allow full egress (legacy).
SANDBOX_ENABLE_EGRESS=false
# Name of the internal no-egress network (created by scripts/setup-sandbox.sh).
SANDBOX_EGRESS_NETWORK=no-egress-net
# Max processes per sandbox container (fork-bomb guard).
SANDBOX_PIDS_LIMIT=256
# Least-privilege Docker socket proxy. Leave blank for local dev (falls back to
# the unix socket); set to the proxy when running hardened. In production the
# backend refuses to boot using the raw socket with no proxy configured.
DOCKER_SOCKET_PROXY_URL=
# Optional outbound proxy for allow-listed egress during install.
HTTP_PROXY=
HTTPS_PROXY=

# --- Scanner APIs ---
AIKIDO_WEBHOOK_SECRET=
AIKIDO_DEV_MODE=               # Set to "true" for mock Aikido findings
SNYK_API_TOKEN=
SNYK_WEBHOOK_SECRET=

# --- Scanner sync (outbound poll) ---
# On a single self-hosted box (no public URL for inbound webhooks), pull findings
# from connected scanners into the DB so it becomes the durable source of truth.
SCANNER_SYNC_ENABLED=false         # Set "true" to enable the periodic outbound poll
SCANNER_SYNC_INTERVAL_MS=900000    # Poll interval in ms (default 15 min)
# Dashboard reads the persisted DB findings list when "true"; otherwise live scanner API.
NEXT_PUBLIC_FINDINGS_FROM_DB=false

# --- Integration cookie / job-payload encryption ---
# Secret for encrypting integration (Aikido / Anthropic / Snyk) cookie data and
# the secret fields placed in Redis (BullMQ) job payloads. The dashboard and the
# backend both read this var so dashboard-encrypted values round-trip in the
# worker. Required in production (both processes fail fast at boot if it is
# missing or weak); generate with: openssl rand -hex 32
INTEGRATION_ENCRYPTION_KEY=replace-me-generate-with-openssl-rand-hex-32
