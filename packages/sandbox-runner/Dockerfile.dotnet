# The base image is passed explicitly (--build-arg BASE_IMAGE=...) and never
# defaults to a mutable :latest tag, so a build can't silently pull an
# unrelated public image. Local: the sutura/sandbox-base you just built;
# CI: the same-commit ACR tag.
ARG BASE_IMAGE
FROM ${BASE_IMAGE}

# Bake the .NET SDK at image-build time so no fix attempt ever downloads it.
# Pinned to a channel for reproducibility; bump deliberately for .NET security
# patches. dotnet-install resolves the right arch (arm64/amd64) automatically.
ARG DOTNET_CHANNEL=10.0
ENV DOTNET_CLI_TELEMETRY_OPTOUT=1 \
    DOTNET_NOLOGO=1 \
    DOTNET_ROOT=/opt/dotnet \
    PATH=/opt/dotnet:$PATH \
    # Disable the workload resolver. SDK 10.0.301 verifies workload manifests on
    # restore ("An issue was encountered verifying workloads"), which fails for
    # plain web/library solutions that use no workloads and aborts the install.
    # These solutions never reference MAUI/wasm/android workloads, so disabling
    # the resolver is safe and keeps restore air-gapped. Both names are honored
    # (DOTNET_* by the host, MSBuild* by the MSBuild evaluation).
    DOTNET_EnableWorkloadResolver=false \
    MSBuildEnableWorkloadResolver=false

RUN curl -sSL https://dot.net/v1/dotnet-install.sh \
      | bash -s -- --channel ${DOTNET_CHANNEL} --install-dir /opt/dotnet \
 && /opt/dotnet/dotnet --info \
 # Symlink onto the default PATH so `dotnet` resolves even under a login shell
 # (`sh -lc`, which the derived toolchain commands use) -- a login shell rebuilds
 # PATH from /etc/profile and would otherwise drop the image's ENV PATH=/opt/dotnet.
 && ln -s /opt/dotnet/dotnet /usr/local/bin/dotnet

WORKDIR /work
CMD ["sleep", "infinity"]
